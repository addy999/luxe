# macOS
**/.DS_Store

# Godot editor cache
project/.godot/

# Build outputs
dist/
project/bin/
extension/.sconsign.dblite
*.os

# Vendored godot-cpp (clone it yourself; see README)
extension/godot-cpp/

# Generated per-machine link flags (regenerate via SConstruct; see README)
extension/dt_link_flags.json

# Test output
scripts/.smoke_out/
scripts/.crop_out/
project/tests/.feature_out
project/tests/.unit_out
scripts/.e2e_out

# Godot regenerates test .uid files on import; don't track them (any depth).
project/tests/**/*.uid
project/tests/*.uid
