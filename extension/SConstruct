#!/usr/bin/env python
"""
SConstruct for the dt_backend GDExtension.

This links a small C++ shim (src/dt_backend.cpp) against:
  1. godot-cpp (vendored as a git submodule at ./godot-cpp, pinned to the
     4.5 branch -- the closest available branch to the installed Godot
     4.6.beta3 editor; see the README prerequisites for details).
  2. darktable's `lib_darktable` shared library (built separately from
     ../../source via build.sh/CMake) plus its GTK3 dependency.

Usage (on Apple Silicon, arch=arm64 is required -- see note below):
    cd godot-poc/extension
    scons arch=arm64                                    # debug build, default dt paths
    scons arch=arm64 target=template_release            # release build
    scons arch=arm64 dt_build_dir=/path/to/source/build dt_src_dir=/path/to/source/src

Note on arch=arm64: godot-cpp's SConstruct defaults macOS builds to
arch=universal (arm64 + x86_64 fat binary). On Apple Silicon, Homebrew
installs arm64-only packages and darktable's build.sh/CMake therefore
produces arm64-only objects, so linking dt_backend against libdarktable.dylib
in a "universal" GDExtension build fails at link time with "found
architecture 'arm64', required architecture 'x86_64'" for every darktable
object file. Passing arch=arm64 makes godot-cpp itself build arm64-only too,
matching darktable. If darktable is later built as a universal/x86_64 binary,
this default can be revisited.

Command-line variables (all optional, see defaults below):
    dt_src_dir    -- darktable's C source include dir (has common/, develop/,
                      imageio/, iop/, etc. as subdirectories). Needed so
                      dt_backend.cpp can `#include "common/darktable.h"` etc.
    dt_build_dir  -- darktable's CMake build directory. This is where
                      CMake drops generated headers (config.h, version_gen.h,
                      preferences_gen.h, ...) as well as the built
                      lib_darktable shared library itself. darktable's
                      build.sh defaults this to `<source>/build`
                      (see source/build.sh: BUILD_DIR_DEFAULT="$DT_SRC_DIR/build").
    dt_lib_name   -- name of the darktable core shared library target to
                      link against. Confirmed via
                      `grep -n add_library source/src/CMakeLists.txt`:
                      `add_library(lib_darktable SHARED ...)` -- so the
                      link name is "darktable" (CMake strips the "lib"
                      prefix for -l flags: -ldarktable -> libdarktable.dylib).
                      NOTE: this is a best-effort default derived from reading
                      darktable's CMakeLists, not a verified build output, so
                      verify it once darktable has been built.
    build_profile -- path to a godot-cpp build profile JSON restricting which
                      engine class bindings get generated/compiled (see
                      build_profile.json alongside this file). Defaults to
                      that file; pass build_profile= (empty) to fall back to
                      godot-cpp's full, untrimmed API surface.

If dt_build_dir does not exist yet (darktable hasn't been built), the
include/link flags below are still added, but linking will fail until the
directory and library exist. That's expected during early scaffolding.
"""

import os

# godot-cpp compiles a binding wrapper class for every engine class in
# extension_api.json (Audio*, Navigation*, Physics*, ...) -- that's not the
# engine itself, just thin C++ stubs, but it's still ~thousands of files. dt_backend.cpp
# only ever touches RefCounted/Image/OS (`grep -oE
# '#include <godot_cpp/classes/[a-z_0-9]+\.hpp>' src/*.cpp src/*.h`), so
# build_profile.json restricts codegen to those three (+ ClassDB/FileAccess/
# WorkerThreadPool/etc., which build_profile.py always force-includes since
# godot-cpp's own internals need them). ARGUMENTS.setdefault lets this stay
# the default while `scons build_profile=...` or `scons build_profile=`
# (empty, i.e. full API) still override it on the command line.
ARGUMENTS.setdefault("build_profile", os.path.join(Dir(".").srcnode().abspath, "build_profile.json"))

env = SConscript("godot-cpp/SConstruct")
# Harmless noise, not a bug: this SConscript call parses its own Variables()
# pass before dt_build_dir/dt_src_dir/dt_lib_name are registered below, so
# SCons prints "WARNING: Unknown SCons variables were passed and will be
# ignored: dt_build_dir=..." here -- vars.Update(env) further down DOES still
# pick these up correctly into env["dt_build_dir"] etc.; verified this is
# the actual value used (not silently dropped) via the debug prints already
# downstream in this file.

# --- darktable integration: configurable paths -----------------------------
extension_dir = Dir(".").srcnode().abspath

default_dt_src_dir = os.path.normpath(
    os.path.join(extension_dir, "..", "..", "source", "src")
)
default_dt_build_dir = os.path.normpath(
    os.path.join(extension_dir, "..", "..", "source", "build")
)

vars = Variables()
vars.Add(
    PathVariable(
        "dt_src_dir",
        "Path to darktable's src/ directory (headers for common/, develop/, imageio/, iop/, ...)",
        default_dt_src_dir,
        PathVariable.PathAccept,
    )
)
vars.Add(
    PathVariable(
        "dt_build_dir",
        "Path to darktable's CMake build directory (generated headers + built lib_darktable)",
        default_dt_build_dir,
        PathVariable.PathAccept,
    )
)
vars.Add(
    "dt_lib_name",
    "Name of the darktable shared library to link against (without lib prefix / extension)",
    "darktable",
)
vars.Update(env)
Help(vars.GenerateHelpText(env))

dt_src_dir = env["dt_src_dir"]
dt_build_dir = env["dt_build_dir"]
dt_lib_name = env["dt_lib_name"]

if not os.path.isdir(dt_build_dir):
    print(
        "*** dt_backend: warning: dt_build_dir '%s' does not exist yet. "
        "Build darktable first (see the README prerequisites) or pass "
        "dt_build_dir=<path> on the scons command line. Continuing to "
        "configure the build; linking will fail until the lib exists."
        % dt_build_dir
    )

# darktable headers: the plain src/ tree, plus wherever CMake places
# generated headers inside the build dir (commonly <build_dir>/src, but
# some generated headers land directly in <build_dir> depending on
# CMAKE_BINARY_DIR conventions -- add both to be safe).
env.Append(
    CPPPATH=[
        dt_src_dir,
        dt_build_dir,
        os.path.join(dt_build_dir, "src"),
    ]
)

# Link against the darktable core shared lib. It may live directly in
# dt_build_dir or under dt_build_dir/src/ depending on CMake layout --
# add both as library search paths.
env.Append(
    LIBPATH=[
        dt_build_dir,
        os.path.join(dt_build_dir, "src"),
        os.path.join(dt_build_dir, "bin"),  # build.sh puts libdarktable.dylib in <build>/bin
    ]
)
# On macOS/Linux, -ldarktable resolves libdarktable.dylib/.so via the LIBPATH
# entries above. Windows is handled separately below.
if env["platform"] != "windows":
    env.Append(LIBS=[dt_lib_name])
else:
    # darktable builds lib_darktable into build/bin (CMakeLists.txt does
    # add_subdirectory(src "${DARKTABLE_BINDIR}") = build/bin, and the target
    # sets no *_OUTPUT_DIRECTORY, so both the DLL and -- via
    # WINDOWS_EXPORT_ALL_SYMBOLS (src/CMakeLists.txt:1187) -- the MinGW import
    # lib land there). We do NOT use `-ldarktable` here: ld's PE `-l` name
    # search varies by toolchain build and silently misses a bare
    # libdarktable.dll (that was the "cannot find -ldarktable" link error).
    # Instead find the actual file and pass it on the link line by absolute
    # path -- MinGW ld links a full-path .dll.a or .dll directly. Prefer the
    # import lib; fall back to the DLL itself.
    import glob as _glob

    _dt_link_target = None
    for _pat in ("libdarktable.dll.a", "darktable.lib", "libdarktable.dll"):
        _hits = _glob.glob(os.path.join(dt_build_dir, "**", _pat), recursive=True)
        if _hits:
            _dt_link_target = _hits[0]
            break
    if _dt_link_target is None:
        print(
            "*** dt_backend: could not find darktable's import lib or DLL under "
            "%s (looked for libdarktable.dll.a / darktable.lib / libdarktable.dll). "
            "Build darktable before the GDExtension." % dt_build_dir
        )
        Exit(1)
    # Forward slashes so the path survives the MinGW g++ command line cleanly
    # regardless of how SCons/Python spelled it.
    _dt_link_target = _dt_link_target.replace("\\", "/")
    print("dt_backend: linking darktable via %s" % _dt_link_target)
    env.Append(LINKFLAGS=[_dt_link_target])

# darktable normally locates its data/module dirs relative to its own
# executable's path (via the vendored `whereami` submodule). That breaks
# when darktable is loaded as a shared library inside a *different*
# executable (Godot.app) -- it ends up looking for
# Godot.app/Contents/Resources/share/darktable, which doesn't exist. dt_init()
# accepts explicit `--datadir`/`--moduledir` argv overrides
# (source/src/common/darktable.c:1132-1140). Rather than baking absolute paths
# in as compile definitions (which broke portability), dt_backend.cpp now
# computes these at runtime instead (env var override / bundle-relative /
# dladdr-relative fallback chain), so no CPPDEFINES are needed here at all.

# libdarktable.dylib's own install name is a bare "@rpath/libdarktable.dylib"
# (CMake's default on macOS), so the loader needs an explicit rpath to find
# it at runtime -- otherwise dlopen()ing dt_backend from Godot fails with
# "Library not loaded: @rpath/libdarktable.dylib" even though it links fine.
if env["platform"] == "macos":
    # Dev-loop rpath: lets the extension run directly from godot-poc/project/bin
    # against source/build/bin (the absolute path to this darktable build)
    # without a full export.
    env.Append(LINKFLAGS=["-Wl,-rpath," + os.path.join(dt_build_dir, "bin")])
    # Bundle rpath: lets the *same* binary also find libdarktable.dylib once
    # Phase 2's dependency-bundling step copies it next to libdt_backend
    # inside an exported .app's Contents/Frameworks/. dyld tries each
    # LC_RPATH in order and uses the first one that resolves, so both rpaths
    # can coexist without a dual-build.
    env.Append(LINKFLAGS=["-Wl,-rpath,@loader_path"])
elif env["platform"] == "linux":
    # Same two-rpath idea as macOS, ELF's RPATH/RUNPATH instead of LC_RPATH.
    # libdarktable.so's own install path is wherever CMake put it (no bare
    # @rpath equivalent to worry about on Linux -- SONAME is just the
    # filename), so an absolute dev-loop rpath plus a bundle-relative
    # $ORIGIN (set by the Linux bundling script once deps are copied
    # alongside the exported binary) covers both cases the same way.
    env.Append(LINKFLAGS=["-Wl,-rpath," + os.path.join(dt_build_dir, "bin")])
    env.Append(LINKFLAGS=["-Wl,-rpath,$$ORIGIN"])
# Windows (MSYS2/MinGW): no rpath concept at all. The PE loader finds
# libdarktable.dll + its deps in the module's own directory, then the
# process's exe directory -- bundle_darktable_deps_windows.sh copies them all
# flat next to Luxe.exe, so nothing to set here. Linking against the import
# lib is handled by -ldarktable + the bin/ LIBPATH above (CMake drops
# libdarktable.dll.a there alongside the .dll).

# --- OpenMP: compile pragmas in, not just link libomp ----------------------
# dt_link_flags.json already puts libomp on the link line (darktable's own
# build links it), but linking alone does not enable OpenMP in the compiler
# frontend. godot-cpp drives Apple clang by default, which rejects a bare
# -fopenmp and wants the frontend flag spelled -Xclang -fopenmp; the version
# pin matches darktable's own CMake flags in source/build/compile_commands.json.
# This is what defines _OPENMP for the parallel byte swap in render_view();
# without it the pragma is skipped and the loop stays serial.
if env["platform"] == "macos":
    env.Append(CXXFLAGS=["-Xclang", "-fopenmp", "-fopenmp-version=51"])
elif env["platform"] == "linux":
    # Real gcc/clang on Linux accepts -fopenmp directly in the frontend; no
    # -Xclang indirection needed (that's an Apple-clang-specific quirk). The
    # version pin is still required though: dt_backend.cpp's `default(firstprivate)`
    # clause (OpenMP 5.1) is rejected by the default OpenMP version a compiler
    # assumes without this flag ("expected 'none' or 'shared' before
    # 'firstprivate'" - confirmed via a real Ubuntu 22.04 build), the same
    # reason the macOS branch above pins -fopenmp-version=51.
    env.Append(CXXFLAGS=["-fopenmp", "-fopenmp-version=51"])
    env.Append(LINKFLAGS=["-fopenmp"])
elif env["platform"] == "windows":
    # MinGW GCC (the only toolchain that can link the MinGW libdarktable.dll)
    # takes -fopenmp directly like Linux gcc, linking libgomp.
    env.Append(CXXFLAGS=["-fopenmp"])
    env.Append(LINKFLAGS=["-fopenmp"])

# darktable.h transitively pulls in dozens of third-party headers (GTK3,
# glib, librsvg, json-glib, exiv2, lensfun, OpenCV, OpenEXR, ...). Rather
# than hand-maintain that list, dt_link_flags.json is generated per-machine
# from the actual CMake build by gen_link_flags.py (compile_commands.json's
# entry for common/darktable.c supplies the include paths and defines;
# the libdarktable.dylib link line supplies the link flags and libraries --
# Ninja's build.ninja or the Makefiles generator's link.txt, whichever the
# darktable build used).
#
# dt_link_flags.json is gitignored: it bakes in absolute paths tied to one
# machine's darktable build, so it is NOT checked in. It is also not
# generated automatically: you must provide it yourself before building.
flags_path = os.path.join(extension_dir, "dt_link_flags.json")
if not os.path.isfile(flags_path):
    print(
        "*** dt_backend: %s not found. It is machine-specific and not "
        "distributed with the source; you need to create it yourself "
        "(include paths, link flags, and defines for your darktable "
        "build) before the GDExtension can compile."
        % flags_path
    )
    Exit(1)
# Read the per-machine flag set generated above.
if os.path.isfile(flags_path):
    import json

    with open(flags_path) as f:
        dt_flags = json.load(f)
    env.Append(CPPPATH=dt_flags.get("includes", []))
    if env["platform"] == "windows":
        # GNU ld is order-sensitive for *archives*, and on Windows darktable's
        # dependency libs (glib, gtk, exiv2, ...) are MinGW import archives
        # (.dll.a), not real shared objects. An archive that appears on the
        # command line BEFORE the object that references it contributes
        # nothing (ld only pulls members that satisfy an already-undefined
        # symbol), so putting them in LINKFLAGS -- which SCons places before
        # $SOURCES -- leaves every g_*/third-party symbol undefined. On Linux
        # the same entries are real .so files (position-insensitive), which is
        # why the shared LINKFLAGS path below works there. Append them to the
        # very end of the link command instead, after $SOURCES and after
        # $_LIBFLAGS (which carries -ldarktable), so the consumer object and
        # -ldarktable both precede these provider archives.
        tail = " ".join(dt_flags.get("link_flags", []) + dt_flags.get("link_libs", []))
        env["_DT_LINK_TAIL"] = tail
        if isinstance(env["SHLINKCOM"], list):
            env["SHLINKCOM"] = env["SHLINKCOM"] + ["$_DT_LINK_TAIL"]
        else:
            env["SHLINKCOM"] = "%s $_DT_LINK_TAIL" % env["SHLINKCOM"]
    else:
        env.Append(LINKFLAGS=dt_flags.get("link_flags", []))
        env.Append(LINKFLAGS=dt_flags.get("link_libs", []))
    # Preprocessor defines matter for more than "does it compile": darktable
    # headers (imageop.h in particular) put optional struct fields behind
    # #ifdef HAVE_OPENCL / USE_LUA / etc. Omitting a define that darktable's
    # own build sets shifts every subsequent struct field's offset, so e.g.
    # dt_iop_module_t.params_size silently reads garbage instead of failing
    # to compile. These must match darktable's own CMake build exactly.
    env.Append(CPPDEFINES=dt_flags.get("defines", []))
# (If the file still doesn't exist, generation failed above and the
# pkg-config fallback has already been applied.)

# --- sources -----------------------------------------------------------
sources = Glob("src/*.cpp")

# Output the built library straight into the Godot project's bin/ dir.
target_dir = "../project/bin/"

if env["platform"] == "macos":
    library = env.SharedLibrary(
        target_dir + "libdt_backend.{}.{}.framework/libdt_backend.{}.{}".format(
            env["platform"], env["target"], env["platform"], env["target"]
        ),
        source=sources,
    )
else:
    library = env.SharedLibrary(
        target_dir + "libdt_backend{}{}".format(env["suffix"], env["SHLIBSUFFIX"]),
        source=sources,
    )

Default(library)
