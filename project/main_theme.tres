[gd_resource type="Theme" format=3 uid="uid://dtluxetheme01"]

; luxe — dark neutral editor theme.
; Greys are R=G=B so the chrome never biases perceived image color/exposure.
; Single muted-blue accent for active/slider states. 4px radius, 1px hairlines.

