; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="darktable-godot-poc"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.6")

[display]

window/size/viewport_width=1024
window/size/viewport_height=768
window/stretch/mode="canvas_items"

[rendering]

textures/vram_compression/import_etc2_astc=true

[dt_backend]

; Local dev/testing only -- resolved relative to this project dir (res://) and
; passed to the DtBackend GDExtension as DT_BACKEND_DATADIR/DT_BACKEND_MODULEDIR
; before init() is called (see Main.gd::_configure_dt_backend_env()). Not used
; by an exported .app (that path is resolved at runtime via
; Contents/Resources/darktable/{share,lib}/darktable -- see
; PORTABILITY_PLAN.md section 3.5). Edit these here (Project > Project Settings
; > General > Dt Backend, enable "Advanced Settings" to see them) if your
; darktable checkout/build lives somewhere other than the sibling source/build/
; this repo builds by default.
datadir="res://../../source/build/share/darktable"
moduledir="res://../../source/build/lib/darktable"
