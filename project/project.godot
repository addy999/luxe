; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Luxe"
config/icon="res://assets/icon.png"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.6")
boot_splash/bg_color=Color(0.145, 0.145, 0.145, 1)
boot_splash/image="res://assets/boot_splash.png"
boot_splash/fullsize=false
boot_splash/use_filter=true

[autoload]

ThemeManager="*res://ThemeManager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="disabled"
window/size/viewport_min_width=900
window/size/viewport_min_height=600

[dt_backend]

datadir="res://../../source/build/share/darktable"
moduledir="res://../../source/build/lib/darktable"

[rendering]

textures/vram_compression/import_etc2_astc=true
