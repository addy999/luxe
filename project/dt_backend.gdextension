[configuration]

entry_symbol = "dt_backend_library_init"
compatibility_minimum = "4.1"
; The locally installed Godot editor is 4.6.beta3, but godot-cpp
; is only available up to the 4.5 branch upstream (no 4.6 branch exists
; yet as of writing). compatibility_minimum is
; kept at 4.1 (the lowest ABI godot-cpp 4.5 supports) rather than 4.6 so
; the extension isn't rejected outright; verify against the actual 4.6
; GDExtension ABI once a matching godot-cpp branch/tag is published.

[libraries]

macos.debug = "res://bin/libdt_backend.macos.template_debug.framework"
macos.release = "res://bin/libdt_backend.macos.template_release.framework"
linux.debug.x86_64 = "res://bin/libdt_backend.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/libdt_backend.linux.template_release.x86_64.so"
windows.debug.x86_64 = "res://bin/libdt_backend.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/libdt_backend.windows.template_release.x86_64.dll"
